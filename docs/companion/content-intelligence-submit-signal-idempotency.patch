+  f.restore();
+});
+
+test("overlapping batches: known ids skipped, new rows kept, duplicate ids within a batch collapsed", async () => {
+  const fake = setup(WITH_ID); const f = stubFetch();
+  await send([note("Batch A1", ID1)]);
