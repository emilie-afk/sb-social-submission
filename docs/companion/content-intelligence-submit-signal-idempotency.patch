From 8d2a6c06b3bd84f1a06479041c09164f2dfd1099 Mon Sep 17 00:00:00 2001
From: SB Team <noreply@succulentsbox.com>
Date: Wed, 28 Oct 2026 16:49:48 +0700
Subject: [PATCH] submit-signal: retry-safe client_submission_id
 (conflict-targeted)

- Rows with a client_submission_id use INSERT ... ON CONFLICT (client_submission_id)
  DO NOTHING; rows not inserted are verified to exist before being acknowledged
- Any other error (unrelated unique constraint, missing migration) returns 500
- Rows without an id keep the previous insert path; no error details returned
- Migration: nullable column + full UNIQUE constraint (run before deploying)
- Tests: node --test tests/*.test.js

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 netlify/functions/submit-signal.js            |  73 ++++++++--
 package.json                                  |   3 +-
 .../20261028_signals_client_submission_id.sql |  21 +++
 tests/submit-signal-idempotency.test.js       | 133 ++++++++++++++++++
 4 files changed, 220 insertions(+), 10 deletions(-)
 create mode 100644 supabase/migrations/20261028_signals_client_submission_id.sql
 create mode 100644 tests/submit-signal-idempotency.test.js

diff --git a/netlify/functions/submit-signal.js b/netlify/functions/submit-signal.js
index 0424064..e62beb5 100644
--- a/netlify/functions/submit-signal.js
+++ b/netlify/functions/submit-signal.js
@@ -86,6 +86,13 @@ exports.handler = async (event) => {
   }
 
   // ── 3. Map to signals table columns ─────────────────────────
+  // Optional idempotency key sent by integrations that retry (the Social Submission site
+  // sends its submission UUID). Rows without it behave exactly as before.
+  const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;
+  const clientId = (s) => {
+    const v = typeof s.client_submission_id === "string" ? s.client_submission_id.toLowerCase() : "";
+    return UUID_RE.test(v) ? v : null;
+  };
   const rows = signals.map((s) => {
     const isManual = s.is_manual ?? s.is_manual_submission ?? false;
     return {
@@ -110,6 +117,8 @@ exports.handler = async (event) => {
     // is_manual: true  = intake sheet or dashboard modal (human submitted)
     // is_manual: false = scraper (not passed → defaults false)
     is_manual_submission:  isManual,
+    // Only set when provided, so callers without it never touch the new column.
+    ...(clientId(s) ? { client_submission_id: clientId(s) } : {}),
     };
   });
 
@@ -134,13 +143,58 @@ exports.handler = async (event) => {
     };
   }
 
-  // ── 5. Batch insert ──────────────────────────────────────────
-  const { data: inserted, error: insertErr } = await supabase
-    .from("signals").insert(newRows).select("id, topic, platform, source_url, caption_summary, plant_or_product, is_manual_submission, priority");
+  // ── 5. Insert ────────────────────────────────────────────────
+  // Rows without an id never reference the new column (works before the migration too).
+  const COLS = "id, topic, platform, source_url, caption_summary, plant_or_product, is_manual_submission, priority";
+  const COLS_WITH_ID = COLS + ", client_submission_id";
+  const withId = [];
+  const withoutId = [];
+  const seenIds = new Set();
+  for (const r of newRows) {
+    if (!r.client_submission_id) { withoutId.push(r); continue; }
+    if (seenIds.has(r.client_submission_id)) continue;          // same id twice in one batch
+    seenIds.add(r.client_submission_id);
+    withId.push(r);
+  }
+  const inserted = [];
+  let acknowledged = 0;
+
+  // 5a. Rows with a client_submission_id: INSERT … ON CONFLICT (client_submission_id) DO NOTHING.
+  // Only a conflict on that exact unique key is ignored; any other error (another unique
+  // constraint, missing migration, …) fails the request, so it is never reported as delivered.
+  if (withId.length) {
+    const { data, error } = await supabase
+      .from("signals")
+      .upsert(withId, { onConflict: "client_submission_id", ignoreDuplicates: true })
+      .select(COLS_WITH_ID);
+    if (error) {
+      console.error("Insert error (idempotent rows):", error.code);
+      return { statusCode: 500, body: JSON.stringify({ error: "Failed to insert signals" }) };
+    }
+    inserted.push(...(data || []));
+    // Rows not inserted must already exist with the same id — verify before acknowledging.
+    const insertedIds = new Set((data || []).map((r) => r.client_submission_id));
+    const notInserted = withId.map((r) => r.client_submission_id).filter((id) => !insertedIds.has(id));
+    if (notInserted.length) {
+      const { data: existing, error: checkErr } = await supabase
+        .from("signals").select("client_submission_id").in("client_submission_id", notInserted);
+      const found = new Set((existing || []).map((r) => r.client_submission_id));
+      if (checkErr || notInserted.some((id) => !found.has(id))) {
+        console.error("Could not confirm existing signals for retried submissions");
+        return { statusCode: 500, body: JSON.stringify({ error: "Failed to insert signals" }) };
+      }
+      acknowledged = notInserted.length;
+    }
+  }
 
-  if (insertErr) {
-    console.error("Insert error:", insertErr);
-    return { statusCode: 500, body: JSON.stringify({ error: "Failed to insert signals", detail: insertErr.message }) };
+  // 5b. Rows without an id: unchanged behaviour.
+  if (withoutId.length) {
+    const { data, error: insertErr } = await supabase.from("signals").insert(withoutId).select(COLS);
+    if (insertErr) {
+      console.error("Insert error:", insertErr.code);
+      return { statusCode: 500, body: JSON.stringify({ error: "Failed to insert signals" }) };
+    }
+    inserted.push(...(data || []));
   }
 
   // ── 6. Auto-cluster (fire and forget) ────────────────────────
@@ -165,9 +219,10 @@ exports.handler = async (event) => {
     statusCode: 200,
     body: JSON.stringify({
       success: true,
-      inserted: newRows.length,
-      skipped,
-      message: `${newRows.length} signal(s) added, ${skipped} duplicate(s) skipped`,
+      inserted: inserted.length,
+      skipped: rows.length - inserted.length,
+      already_received: acknowledged,
+      message: `${inserted.length} signal(s) added, ${rows.length - inserted.length} duplicate(s) skipped`,
     }),
   };
 };
