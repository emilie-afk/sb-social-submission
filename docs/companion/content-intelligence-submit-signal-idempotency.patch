diff --git a/supabase/migrations/20261028_signals_client_submission_id.sql b/supabase/migrations/20261028_signals_client_submission_id.sql
new file mode 100644
index 0000000..d33c9a5
--- /dev/null
+++ b/supabase/migrations/20261028_signals_client_submission_id.sql
@@ -0,0 +1,21 @@
+-- Idempotency key for signals from integrations that retry (the Social Submission site
+-- sends client_submission_id = its submission UUID).
+-- Additive and backward compatible: the column is nullable, and PostgreSQL treats NULLs as
+-- distinct in a UNIQUE constraint, so existing rows and callers without an id are unaffected.
+-- A full (non-partial) UNIQUE constraint is used so that
+--   INSERT … ON CONFLICT (client_submission_id) DO NOTHING
+-- (supabase-js upsert with ignoreDuplicates) can target it.
+-- Run this BEFORE deploying the matching submit-signal.js.
+
+alter table public.signals add column if not exists client_submission_id text;
+
+do $$
+begin
+  if not exists (
+    select 1 from pg_constraint
+    where conrelid = 'public.signals'::regclass and conname = 'signals_client_submission_id_key'
+  ) then
+    alter table public.signals
+      add constraint signals_client_submission_id_key unique (client_submission_id);
+  end if;
+end $$;
diff --git a/tests/submit-signal-idempotency.test.js b/tests/submit-signal-idempotency.test.js
new file mode 100644
index 0000000..83bb540
--- /dev/null
+++ b/tests/submit-signal-idempotency.test.js
@@ -0,0 +1,133 @@
+// Tests for client_submission_id idempotency in submit-signal (fake Supabase client that
+// mirrors PostgREST semantics: upsert+ignoreDuplicates = INSERT … ON CONFLICT (col) DO NOTHING).
+// SQL semantics of the migration are verified separately against PostgreSQL 16.
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const Module = require("node:module");
+
+function makeDb({ migrated = true, failNextWith = null } = {}) {
+  const db = { rows: [], migrated, failNextWith, nextId: 1 };
+  const err = (code) => ({ code, message: "error " + code });
+  db.client = {
+    from() {
+      const q = {
+        _cols: null, _in: null,
+        select(cols) { q._cols = cols; return q; },
+        eq() { return q; },
+        in(col, vals) { q._in = [col, vals]; return q; },
+        update() { return { eq: () => Promise.resolve({}) }; },
+        single: async () => ({ data: { id: "t", active: true, allowed_action: "submit_signal", rate_limit_per_hour: 500 }, error: null }),
+        then(res, rej) {
+          const [col, vals] = q._in || [];
+          if (col === "client_submission_id" && !db.migrated) return Promise.resolve({ data: null, error: err("42703") }).then(res, rej);
+          return Promise.resolve({ data: db.rows.filter((r) => vals.includes(r[col])), error: null }).then(res, rej);
+        },
+        insert(newRows) {
+          return { select: async (cols) => {
+            // Like PostgREST: selecting a column that does not exist fails the whole statement.
+            if (!db.migrated && String(cols || "").includes("client_submission_id")) return { data: null, error: err("42703") };
+            if (db.failNextWith) { const c = db.failNextWith; db.failNextWith = null; return { data: null, error: err(c) }; }
+            if (!db.migrated && newRows.some((r) => "client_submission_id" in r)) return { data: null, error: err("42703") };
+            const out = newRows.map((r) => ({ id: db.nextId++, client_submission_id: null, ...r }));
+            db.rows.push(...out); return { data: out, error: null };
+          } };
+        },
+        upsert(newRows, opts) {
+          return { select: async () => {
+            if (!db.migrated) return { data: null, error: err("42P10") };
+            assert.equal(opts.onConflict, "client_submission_id");
+            assert.equal(opts.ignoreDuplicates, true);
+            // An unrelated unique constraint still raises 23505 (ON CONFLICT targets one key only).
+            if (db.failNextWith) { const c = db.failNextWith; db.failNextWith = null; return { data: null, error: err(c) }; }
+            const out = [];
+            for (const r of newRows) {
+              if (db.rows.some((x) => x.client_submission_id === r.client_submission_id)) continue;
+              const row = { id: db.nextId++, ...r }; db.rows.push(row); out.push(row);
+            }
+            return { data: out, error: null };
+          } };
+        },
+      };
+      return q;
+    },
+  };
+  return db;
+}
+
+function loadHandler(db) {
+  const path = require.resolve("../netlify/functions/submit-signal.js");
+  delete require.cache[path];
+  const orig = Module._load;
+  Module._load = function (req, ...a) {
+    if (req === "@supabase/supabase-js") return { createClient: () => db.client };
+    return orig.call(this, req, ...a);
+  };
+  try { return require(path).handler; } finally { Module._load = orig; }
+}
+
+process.env.SUPABASE_URL = "http://fake"; process.env.SUPABASE_SERVICE_ROLE_KEY = "fake";
+delete process.env.CLAUDE_API_KEY; // no auto-cluster calls in tests
+const ev = (body) => ({ httpMethod: "POST", headers: { "x-submission-token": "x" }, body: JSON.stringify(body) });
+const ID = "3f1c2b9e-1a2b-4c3d-8e9f-0a1b2c3d4e5f";
+const ID2 = "4f1c2b9e-1a2b-4c3d-8e9f-0a1b2c3d4e5f";
+const sig = (over = {}) => ({ topic: "text only signal", is_manual: true, client_submission_id: ID, ...over });
+const body = (r) => JSON.parse(r.body);
+
+test("first delivery inserts; a retry with the same id is acknowledged without a new row", async () => {
+  const db = makeDb(); const h = loadHandler(db);
+  const r1 = await h(ev([sig()]));
+  assert.equal(r1.statusCode, 200); assert.equal(body(r1).inserted, 1);
+  const r2 = await h(ev([sig()]));
+  assert.equal(r2.statusCode, 200); assert.equal(body(r2).inserted, 0); assert.equal(body(r2).already_received, 1);
+  assert.equal(db.rows.length, 1);
+});
+
+test("concurrent same-id requests produce one row and both are acknowledged", async () => {
+  const db = makeDb(); const h = loadHandler(db);
+  const rs = await Promise.all([h(ev([sig()])), h(ev([sig()])), h(ev([sig()]))]);
+  assert.ok(rs.every((r) => r.statusCode === 200));
+  assert.equal(db.rows.length, 1);
+});
+
+test("an unrelated unique violation (23505) is NOT acknowledged as delivered", async () => {
+  const db = makeDb({ failNextWith: "23505" }); const h = loadHandler(db);
+  const r = await h(ev([sig()]));
+  assert.equal(r.statusCode, 500);
+  assert.equal(body(r).success, undefined);
+  assert.equal(db.rows.length, 0);
+});
+
+test("missing migration fails the request (no false success)", async () => {
+  const db = makeDb({ migrated: false }); const h = loadHandler(db);
+  const r = await h(ev([sig()]));
+  assert.equal(r.statusCode, 500);
+});
+
+test("callers without an id are unchanged, also before the migration", async () => {
+  const db = makeDb({ migrated: false }); const h = loadHandler(db);
+  const r = await h(ev([{ topic: "scraper row", source_url: "https://x.example/1" }]));
+  assert.equal(r.statusCode, 200); assert.equal(body(r).inserted, 1);
+  assert.ok(!("client_submission_id" in db.rows[0]) || db.rows[0].client_submission_id === null);
+  const again = await h(ev([{ topic: "scraper row", source_url: "https://x.example/1" }]));
+  assert.equal(body(again).inserted, 0, "source_url dedupe still applies");
+});
+
+test("overlapping batches: known ids acknowledged, new rows (with and without ids) inserted", async () => {
+  const db = makeDb(); const h = loadHandler(db);
+  await h(ev([sig()]));
+  const r = await h(ev([sig(), sig({ client_submission_id: ID2, topic: "second" }), { topic: "no id row" }, sig({ client_submission_id: "not-a-uuid", topic: "bad id" })]));
+  const b = body(r);
+  assert.equal(r.statusCode, 200);
+  assert.equal(b.inserted, 3);              // ID2 + "no id row" + "bad id" (treated as no id)
+  assert.equal(b.already_received, 1);
+  assert.equal(db.rows.length, 4);
+});
+
+test("an id that is neither inserted nor found is not acknowledged", async () => {
+  const db = makeDb(); const h = loadHandler(db);
+  // Simulate an upsert that silently skips a row that does not exist (should never happen).
+  const orig = db.client.from;
+  db.client.from = () => { const q = orig(); const up = q.upsert; q.upsert = (rows, o) => ({ select: async () => ({ data: [], error: null }) }); return q; };
+  const r = await h(ev([sig()]));
+  assert.equal(r.statusCode, 500);
+});
